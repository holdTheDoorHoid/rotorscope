target/
**/target/
**/target-band24/
**/target-espnow/
**/target-bus/
*.bin
*.elf
# Hub station-mode credentials: created by the owner, never committed.
firmware/hub/wifi.local.toml
# Downloaded test recordings (third-party licences; never commit).
testdata/
# rfuav-check outputs (features and summaries of RFUAV recordings; local).
rfuav-results/
rfuav-data/

# Local bench boards (per machine) and bench run logs.
tools/boards.local
bench-logs/
__pycache__/
firmware/patches/esp-hal-p4-pre-v3/upstream

# Airspace-pack downloads and packs (public data, never committed).
tools/airspace-pack/cache/
*.PAK
# Evidence signing keys (development keys: never commit)
*.evkey
evidence-data/

# O4 DroneID keys are the owner's and never belong in this public repository.
O4KEY.TXT
*.o4key
*o4key*.txt

# The retired one-per-kit ESP-NOW link key (version 2 firmware; nothing reads it
# any more, but an owner may keep the file until every board is reflashed): never commit.
tools/link.key
*.linkkey
# Kit master and roster (per-node link keys, `cargo run -p link-key -- kit new`):
# never commit. The roster holds no secrets but is per kit.
tools/kit.key
tools/kit.roster
tools/kit.roster.new
tools/kit.key.new

# FLARM legacy keys: the owner may use them (2026-11-17) but they are never
# published. Made by `cargo run -p flarm-keys` from a SoftRF checkout; on the
# hub they live on the SD card as ROTORSCP/FLARMKEY.TXT.
tools/flarm.keys
FLARMKEY.TXT
*.flarmkeys

# Documentation site: the diagram library is fetched by tools/docs-build.sh.
docs/assets/mermaid.min.js
